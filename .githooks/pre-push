#!/usr/bin/env bash
# Pre-push leak guard (#9483, omarchy-rec #3): block a push that would leak private
# host names, IPs, home paths, private names, or the design-system reference into the
# public tree — "Copybara without Copybara". Structural, not reliant on review.
# Override a genuine false positive with:  git push --no-verify
set -uo pipefail

DENY='omarchy|/Users/[a-z]|/home/[a-z]|(^|[^0-9])10\.(104|255|83)\.|(^|[^0-9])100\.(8[0-9]|9[0-9])\.|rishirajs|design-reference/_ds|(^|/)kosaten/'
ZERO=0000000000000000000000000000000000000000
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue           # branch deletion
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"                             # new branch: scan its tip commit
  else
    range="$remote_sha..$local_sha"                # only the commits being pushed
  fi
  hits=$(git diff "$range" -- . ':(exclude).githooks/*' ':(exclude).github/workflows/leakguard.yml' 2>/dev/null | grep -E '^\+' | grep -inE "$DENY" | head -25 || true)
  if [ -n "$hits" ]; then
    echo "" >&2
    echo "  ✖ pre-push blocked ($local_ref): private material in the pushed diff —" >&2
    echo "$hits" | sed 's/^/      /' >&2
    fail=1
  fi
done

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --no-banner >/dev/null 2>&1; then
    echo "  ✖ gitleaks found a secret in the pushed range" >&2
    fail=1
  fi
fi

if [ "$fail" != "0" ]; then
  echo "" >&2
  echo "  Push aborted. If this is a false positive: git push --no-verify" >&2
  exit 1
fi
exit 0
