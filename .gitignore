TERRITORY.md
.bin/
http-mcp
# built command binaries must never be committed — build.sh regenerates them
# per-machine into .bin/ + ./http-mcp. channel/mcp were tracked as stale Linux
# ELF orphans (wrong arch on any other host); untracked so a clone builds clean.
channel
mcp

# runtime logs / stray artifacts (host + upstream-hub data leaks) — never commit
*.log
lt.log
ltcupdate

# gitignored LT credential files (never commit)
/auth/*.json
